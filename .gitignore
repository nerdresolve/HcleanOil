# dependências
node_modules/

# build
.next/
dist/
out/
apps/backend/preview/
# Propostas geradas e o contador de numeracao sao dados de execucao
apps/backend/propostas/
apps/backend/Proposta_*.pdf
apps/backend/*.png
apps/frontend/scripts/screenshots/
*.tsbuildinfo

# ------------------------------------------------------------------ segredos
# Credenciais: SMTP, token do tunnel, chaves de API. Nunca versionar.
# O padrao cobre qualquer sufixo (.env.local, .env.bak-pre-tunnel, .env.old):
# um backup do .env carrega exatamente os mesmos segredos que o original.
.env
.env*
!.env.example
*.pem
*.key
credentials.json

# ----------------------------------------------- documentos internos do cliente
# Tabela de precos, negociacoes em aberto e decisoes comerciais. O repositorio
# e publico; estes arquivos ficam so no disco de quem trabalha no projeto.
PRECOS.md
TAREFAS.md
ESTUDO-PROPOSTA-AUTOMATICA.md

# logs
*.log
npm-debug.log*

# sistema
.DS_Store
Thumbs.db

